    {
      "id": "c2000000-0000-4000-8000-000000000003",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        460,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.content }}",
        "options": {
          "systemMessage": "Tum \"Demo Shop\" ke customer support assistant ho.\n\nRules:\n1. Har sawaal par PEHLE knowledge_base tool se search karo.\n2. Sirf wahi jawab do jo tool ke result mein likha hai. Apni taraf se kuch mat banao.\n3. Jawab chhota (1-3 lines), polite, aur customer ki hi language mein do (Hindi, Hinglish ya English).\n4. In haalat mein sirf ek shabd likho: HANDOFF\n   - tool mein jawab nahi mila,\n   - customer insaan/agent se baat karna chahta hai,\n   - customer gussa ya pareshaan hai.\n   HANDOFF ke saath aur kuch mat likho.",
          "maxIterations": 5
        }
      }
    },
    {
      "id": "c2000000-0000-4000-8000-000000000004",
      "name": "Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        380,
        220
      ],
      "parameters": {
        "modelName": "models/gemini-2.5-flash-lite",
        "options": {
          "temperature": 0.2
        }
      },
      "credentials": {
        "googlePalmApi": {
          "id": "TVLoFE2T2FDezT6s",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "id": "c2000000-0000-4000-8000-000000000005",
      "name": "knowledge_base",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1.3,
      "position": [
        560,
        220
      ],
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolDescription": "Demo Shop ke FAQ aur policies (refund, return, delivery, COD, payment, support hours) mein search karta hai. Customer ke har sawaal ke liye isse use karo.",
        "qdrantCollection": {
          "__rl": true,
          "mode": "id",
          "value": "knowledge_base"
        },
        "topK": 4,
        "options": {}
      },
      "credentials": {
        "qdrantApi": {
          "id": "qdrantLocal00001",
          "name": "Qdrant Local"
        }
      }
    },
